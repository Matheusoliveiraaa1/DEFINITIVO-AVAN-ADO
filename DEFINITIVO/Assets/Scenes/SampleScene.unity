  - {fileID: 21300000, guid: 65f3d4eca75ff6c45b5ee82457e6527b, type: 3}
  serrapilheiraStickers:
  - {fileID: 21300000, guid: c20167e9d59c5594387f2b5943766f6c, type: 3}
  - {fileID: 21300000, guid: ca6ba0df2c7a63746b13f432de15103a, type: 3}
  - {fileID: 21300000, guid: 05bfde42574703c4998b6ad56d2ee4c8, type: 3}
  - {fileID: 21300000, guid: 07e69e753e4aad74c8c5fa77a79ee153, type: 3}
  - {fileID: 21300000, guid: f1b071ce6c8cf494287dacfe9a98e739, type: 3}
  speciesInfoPanel: {fileID: 1535652481}
  commonNameText: {fileID: 685874614}
  scientificNameText: {fileID: 749904801}
  realImage: {fileID: 1983818534}
  stickerImage: {fileID: 514338060}
  descriptionText: {fileID: 2137887358}
  backButton: {fileID: 1923186124}
  cursoDaguaImage: {fileID: 21300000, guid: bda595251d1f60f40a0876d83ef71eec, type: 3}
  subosqueImage: {fileID: 21300000, guid: 2e4d546fef445a64ea356d5dce9ac1a5, type: 3}
  dosselImage: {fileID: 21300000, guid: 87878b52b63501b4cbcc848e17786fac, type: 3}
  epifitasImage: {fileID: 21300000, guid: 70d7513856a4e89459017322dfcf95e6, type: 3}
  serrapilheiraImage: {fileID: 21300000, guid: ba9c62e8e35efcf4299e0a43b4c2666e, type: 3}
  speciesList:
  - commonName: "Camar\xE3o"
    scientificName: Macrobrachium potiuna
    realPhoto: {fileID: 21300000, guid: 89089987f6880e74e84f236c23b060c3, type: 3}
    stickerSprite: {fileID: 21300000, guid: 3b4ca1a72ffe4a146b80c41b8a213f42, type: 3}
    description: "Vive em riachos limpos e bem oxigenados. Esse pequeno camar\xE3o
      de \xE1gua\r\ndoce ajuda a manter o equil\xEDbrio do ecossistema e indica boa
      qualidade da \xE1gua.\r"
  - commonName: Girino
    scientificName: 
    realPhoto: {fileID: 21300000, guid: 6ffb36e07f2d4ca408e2a944244b94ad, type: 3}
    stickerSprite: {fileID: 21300000, guid: 034235bde09704d41921a678a24489a5, type: 3}
    description: "Fase jovem dos anf\xEDbios, vive na \xE1gua e respira por br\xE2nquias.
      Alimenta-se de algas e restos org\xE2nicos, ajudando a manter o ambiente limpo.\r        
      \r"
  - commonName: Anfibio
    scientificName: Leptodactylus paranaru
    realPhoto: {fileID: 21300000, guid: 5cef873b1b6c7674d9b173ae851991ef, type: 3}
    stickerSprite: {fileID: 21300000, guid: dc0a371eda9c58f4f81493dfb6d0fbbd, type: 3}
    description: "R\xE3 de coaxar forte que vive perto da \xE1gua. Alimenta-se de
      insetos e \xE9 sens\xEDvel \xE0 polui\xE7\xE3o -- um importante indicador da
      sa\xFAde ambiental como todo anf\xEDbio."
  - commonName: "Caet\xE9"
    scientificName: Heliconia farinosa
    realPhoto: {fileID: 21300000, guid: f50ca8544ab03f5448083fe682bc2815, type: 3}
    stickerSprite: {fileID: 21300000, guid: 01868aa5e21777841b855ed20cddb290, type: 3}
    description: "Planta tropical de cores vibrantes que atrai beija-flores. Suas
      flores ajudam na poliniza\xE7\xE3o e embelezam o interior da floresta.\r"
  - commonName: Caranguejo
    scientificName: Trichodactylus fluviatilis
    realPhoto: {fileID: 21300000, guid: cd8dcf7da8a35374aa7ba93c04b9c958, type: 3}
    stickerSprite: {fileID: 21300000, guid: 3977d264d7261ca41962ae28e3be892b, type: 3}
    description: "Mora nas margens de rios e c\xF3rregos. Alimenta-se de restos de
      plantas e animais, auxiliando na decomposi\xE7\xE3o e ciclagem de nutrientes
      do ambiente.\r\n\r"
  - commonName: Peixe
    scientificName: Phalloceros sp.
    realPhoto: {fileID: 21300000, guid: 22d2331933e82754695ab9ac575e9411, type: 3}
    stickerSprite: {fileID: 21300000, guid: 29b44e0a7e9c1754685e543ca52e05b3, type: 3}
    description: "Pequeno e resistente, vive em riachos calmos. Alimenta-se de algas
      e insetos, mantendo o equil\xEDbrio da vida aqu\xE1tica.\r"
  - commonName: Cogumelo
    scientificName: Agaricus sp.
    realPhoto: {fileID: 21300000, guid: 444e377210359484baf670ddfe4bfcd5, type: 3}
    stickerSprite: {fileID: 21300000, guid: c20167e9d59c5594387f2b5943766f6c, type: 3}
    description: "Surge em locais \xFAmidos e ricos em mat\xE9ria org\xE2nica. Recicla
      nutrientes, transformando o que morreu em nova vida no solo."
  - commonName: Aranha-lobo
    scientificName: Ctenus ornatus
    realPhoto: {fileID: 21300000, guid: 93685cc29d5787640ae3a2a024716ceb, type: 3}
    stickerSprite: {fileID: 21300000, guid: 07e69e753e4aad74c8c5fa77a79ee153, type: 3}
    description: "Ca\xE7adora \xE1gil que vive no ch\xE3o da floresta. Controla popula\xE7\xF5es
      de insetos, sendo uma das principais predadoras da serrapilheira."
  - commonName: Semente germinando
    scientificName: Euterpe edulis
    realPhoto: {fileID: 21300000, guid: e21fed4b69fcaee4ab5c30784db10f42, type: 3}
    stickerSprite: {fileID: 21300000, guid: f1b071ce6c8cf494287dacfe9a98e739, type: 3}
    description: "O nascimento de um novo palmito-ju\xE7ara, \xE1rvore essencial
      da Mata Atl\xE2ntica, alimento para aves e s\xEDmbolo de regenera\xE7\xE3o.\r"
  - commonName: Inhambu
    scientificName: Crypturellus tataupa
    realPhoto: {fileID: 21300000, guid: 15df305961e6f5242b26e57f93ca2680, type: 3}
    stickerSprite: {fileID: 21300000, guid: 05bfde42574703c4998b6ad56d2ee4c8, type: 3}
    description: "Ave terr\xEDcola e discreta. Come sementes e insetos, ajudando
      na manuten\xE7\xE3o e regenera\xE7\xE3o da floresta.\r"
  - commonName: Rato-do-mato
    scientificName: Akodon azarae
    realPhoto: {fileID: 21300000, guid: b17dde6b4d3a8434b8161e0d5df92721, type: 3}
    stickerSprite: {fileID: 21300000, guid: ca6ba0df2c7a63746b13f432de15103a, type: 3}
    description: "Pequeno roedor da floresta. Espalha sementes e serve de alimento
      para v\xE1rios predadores, mantendo o ciclo natural."
  - commonName: 'Muda de palmito '
    scientificName: Euterpe edulis
    realPhoto: {fileID: 21300000, guid: c8cfd13485cd6524288134d0c4405231, type: 3}
    stickerSprite: {fileID: 21300000, guid: e7218cacb5d2d434880bb7afd2ef0d7e, type: 3}
    description: "Jovem palmito-ju\xE7ara crescendo sob a sombra da floresta. Sua
      presen\xE7a garante alimento e abrigo para muitas esp\xE9cies.\r"
  - commonName: Samambaia
    scientificName: Danaea geniculata
    realPhoto: {fileID: 21300000, guid: 3b051c94d0c1545469b7dc94d224680d, type: 3}
    stickerSprite: {fileID: 21300000, guid: 5200baea30521924cb7c68cc99b798fd, type: 3}
    description: "Gosta de lugares \xFAmidos e sombreados. Suas folhas ajudam a manter
      a umidade e proteger o solo da eros\xE3o.\r"
  - commonName: 'Planta '
    scientificName: Goeppertia monophylla
    realPhoto: {fileID: 21300000, guid: 1ee8d6a05030f2e4f8549aaf60829258, type: 3}
    stickerSprite: {fileID: 21300000, guid: 1ea0266ffb53c5e4f81caf40e123a99d, type: 3}
    description: "Esp\xE9cie de folhas largas do sub-bosque. Ajuda a manter o microclima
      \xFAmido e abriga pequenos animais da floresta."
  - commonName: "Camale\xE3ozinho"
    scientificName: Enyalius iheringii
    realPhoto: {fileID: 21300000, guid: 95307ff9ef65f964f97ed8c5cae90f0e, type: 3}
    stickerSprite: {fileID: 21300000, guid: 7a63eedbac48da4448d847459ef38e7d, type: 3}
    description: "Lagarto que vive entre as \xE1rvores e muda de cor para se camuflar.
      Ca\xE7a insetos e ajuda a manter o equil\xEDbrio ecol\xF3gico.\r"
  - commonName: "Ti\xE9-sangue"
    scientificName: Ramphocelus bresilius
    realPhoto: {fileID: 21300000, guid: 080c143f16dc7d546997a28dc213b6c9, type: 3}
    stickerSprite: {fileID: 21300000, guid: 3579e950eaf144c46b925a029a88d30e, type: 3}
    description: "Ave de plumagem vermelha intensa. Alimenta-se de frutos e espalha
      sementes, colorindo e renovando a floresta.\r"
  - commonName: "Brom\xE9lia"
    scientificName: Vriesea incurvata
    realPhoto: {fileID: 21300000, guid: db33459cfee14e542871f43e2b4002d7, type: 3}
    stickerSprite: {fileID: 21300000, guid: 65f3d4eca75ff6c45b5ee82457e6527b, type: 3}
    description: "Acumula \xE1gua entre as folhas, criando abrigos para insetos e
      pererecas. Um pequeno universo dentro da floresta."
  - commonName: Beija-Flor
    scientificName: Eupetomena macroura
    realPhoto: {fileID: 21300000, guid: d00d43f5abdca9d4d9ea19b4e92978f9, type: 3}
    stickerSprite: {fileID: 21300000, guid: d5ceaec2e53b50e4d8e9223562ce42b2, type: 3}
    description: "Com voo r\xE1pido e preciso, visita flores em busca de n\xE9ctar.
      Poliniza plantas de diversas esp\xE9cies, especialmente com flores tubulares. "
  - commonName: Perereca
    scientificName: Phyllodytes luteolus
    realPhoto: {fileID: 21300000, guid: f86999f0c594e374bbd7c577cdec5e5f, type: 3}
    stickerSprite: {fileID: 21300000, guid: c7746fad7647b4140adbcb6622f425b9, type: 3}
    description: "Vive em brom\xE9lias e nelas cria seus filhotes. \xC9 sens\xEDvel
      \xE0s mudan\xE7as do ambiente e indica equil\xEDbrio ecol\xF3gico."
  - commonName: Musgo
    scientificName: 
    realPhoto: {fileID: 21300000, guid: 68cb51f1529b32c46b7ada2e599b7b7f, type: 3}
    stickerSprite: {fileID: 21300000, guid: 0f91da6d00148574f9a5104cdac10ef1, type: 3}
    description: "Pequeno e delicado, cresce onde h\xE1 umidade. Ret\xE9m \xE1gua
      e prepara o solo para novas plantas. "
  - commonName: "Orqu\xEDdea"
    scientificName: Cattleya purpurata
    realPhoto: {fileID: 21300000, guid: b1ca91e7902d56143ace7e13be2b9029, type: 3}
    stickerSprite: {fileID: 21300000, guid: c5f89903d92a4564592ddadf9c63778c, type: 3}
    description: "Flor s\xEDmbolo de Santa Catarina, vive sobre \xE1rvores sem prejudic\xE1-las.
      Atrai polinizadores e representa a beleza da Mata Atl\xE2ntica."
  - commonName: Bugio
    scientificName: Alouatta guariba
    realPhoto: {fileID: 21300000, guid: 88fdf662b18ca7a47b18bf544d988a57, type: 3}
    stickerSprite: {fileID: 21300000, guid: bb4dba59b6181f4478ed055e6020ceb4, type: 3}
    description: "Macaco de grande porte e vocaliza\xE7\xE3o poderosa. Vive em grupos
      e ajuda a espalhar sementes por toda a floresta. "
  - commonName: Morcego
    scientificName: Artibeus sp.
    realPhoto: {fileID: 21300000, guid: ebcc18b6b83770346a81df5886b912da, type: 3}
    stickerSprite: {fileID: 21300000, guid: e10c79eb4ebc0c2459ee7202c6b93836, type: 3}
    description: "Alimenta-se de frutos e espalha sementes ao voar longas dist\xE2ncias.
      Um jardineiro noturno essencial para a regenera\xE7\xE3o das matas."
  - commonName: "Cobra-cip\xF3"
    scientificName: Philodryas olfersii
    realPhoto: {fileID: 21300000, guid: 65b7bfea9c3abc84d85e01fb45a130b4, type: 3}
    stickerSprite: {fileID: 21300000, guid: 138c800e490e9d041bf758a02a876370, type: 3}
    description: "Serpente esguia e verde, camuflada entre os galhos. Ca\xE7a anf\xEDbios
      e pequenos animais, controlando suas popula\xE7\xF5es na copa das \xE1rvores. "
  - commonName: Macaco-Prego
    scientificName: Sapajus apella
    realPhoto: {fileID: 21300000, guid: 35bcfde66ba11ec45867520587118d9d, type: 3}
    stickerSprite: {fileID: 21300000, guid: e3f9379be0717d2439fb8a68313c51f3, type: 3}
    description: "Macaco \xE1gil e muito inteligente. Vive em grupos e \xE9 conhecido
      por usar pedras para quebrar alimentos, ajudando tamb\xE9m na dispers\xE3o
      de sementes na floresta."
  - commonName: "Gavi\xE3o"
    scientificName: Spizaetus tyrannus
    realPhoto: {fileID: 21300000, guid: e0084057524a8564d86f406c723cf792, type: 3}
    stickerSprite: {fileID: 21300000, guid: c7e5297a1f8818947aa9538fe372838c, type: 3}
    description: "Predador de topo, conhecido como gavi\xE3o-pega-macaco. Mant\xE9m
      o equil\xEDbrio natural controlando popula\xE7\xF5es de outras esp\xE9cies."
