  - {fileID: 21300000, guid: d37e5e04e1f7f2b4cabe6c369870d588, type: 3}
  - {fileID: 21300000, guid: 7674df92c005ec745900b58144c75aa8, type: 3}
  - {fileID: 21300000, guid: d37e5e04e1f7f2b4cabe6c369870d588, type: 3}
  - {fileID: 21300000, guid: 6ccf2619504693f46b5ed7b298afe4b8, type: 3}
  - {fileID: 21300000, guid: 7674df92c005ec745900b58144c75aa8, type: 3}
  tutorialMessages:
  - "Ol\xE1! Eu sou a Maria Sassafras e irei te ensinar como utilizar esse aplicativo!"
  - "Voc\xEA dever\xE1 caminhar pela trilha atr\xE1s de sticikers e colet\xE1-los."
  - "Ent\xE3o, haver\xE3o \xE1reas especiais de foto, nas quais voc\xEA ir\xE1 utilizar
    os stickers coletados!"
  - "Lembre-se! voc\xEA dever\xE1 usar apenas os sticker de cada devida \xE1rea nas
    fotos..."
  - "As fotos decoradas ir\xE3o aparecer na sua galeria, assim como os stickers na
    cole\xE7\xE3o!"
  - "Agora que voc\xEA j\xE1 sabe o b\xE1sico, vamos come\xE7ar!"
  slideInDuration: 0.8
  idleMovementAmount: 10
  idleMovementSpeed: 1
  idleRotationAmount: 2
  typingSpeed: 0.05
