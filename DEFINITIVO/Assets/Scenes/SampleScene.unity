--- !u!114 &1321318705
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1321318701}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 076d04c645b333d4f9fab803d9ed6d2c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialPanel: {fileID: 1321318701}
  professoraImage: {fileID: 1671931763}
  extraImageUI: {fileID: 1780923019}
  tutorialText: {fileID: 1516534292}
  nextButton: {fileID: 197444067}
  slides:
  - message: "Ol\xE1! Eu sou a Maria Sassafras e irei te ensinar como utilizar esse
      aplicativo!  "
    professoraSprite: {fileID: 21300000, guid: 6ccf2619504693f46b5ed7b298afe4b8, type: 3}
    extraImage: {fileID: 0}
  - message: "Ao caminha pela trilha, voc\xEA ira encontrar ir\xE1 encontrar algumas
      figuras de esp\xE9cies desse parque, como essa ao meu lado."
    professoraSprite: {fileID: 21300000, guid: d37e5e04e1f7f2b4cabe6c369870d588, type: 3}
    extraImage: {fileID: 21300000, guid: eb6668e6672b47f49b03c5ef769ee5c3, type: 3}
  - message: "Abra a aba cole\xE7\xE3o para saber mais sobra as esp\xE9cies que voc\xEA
      ja encontrou!"
    professoraSprite: {fileID: 21300000, guid: 7674df92c005ec745900b58144c75aa8, type: 3}
    extraImage: {fileID: 21300000, guid: 325f19548257d1e48845075246f70556, type: 3}
  - message: "Ent\xE3o, haver\xE3o \xE1reas especiais de foto, nas quais voc\xEA
      ir\xE1 utilizar essas figuras coletadas! "
    professoraSprite: {fileID: 21300000, guid: d37e5e04e1f7f2b4cabe6c369870d588, type: 3}
    extraImage: {fileID: 21300000, guid: 6f2a6c3aaa39ea641a247a898528cbd7, type: 3}
  - message: "Lembre-se de checar o mapa, para saber quais \xE1reas voc\xEA ja visitou!"
    professoraSprite: {fileID: 21300000, guid: 6ccf2619504693f46b5ed7b298afe4b8, type: 3}
    extraImage: {fileID: 21300000, guid: ba0ee7812c1ed7142a11126c62e13347, type: 3}
  - message: "Todas as fotos decoradas ir\xE3o aparecer na sua galeria, como recorda\xE7\xE3o.  "
    professoraSprite: {fileID: 21300000, guid: d37e5e04e1f7f2b4cabe6c369870d588, type: 3}
    extraImage: {fileID: 0}
  - message: "Voc\xEA j\xE1 ir\xE1 come\xE7ar com algumas figuras em m\xE3os, verifique
      a aba cole\xE7\xE3o para saber quais s\xE3o."
    professoraSprite: {fileID: 21300000, guid: 6ccf2619504693f46b5ed7b298afe4b8, type: 3}
    extraImage: {fileID: 0}
  - message: "Agora que voc\xEA j\xE1 sabe o b\xE1sico, vamos come\xE7ar!"
    professoraSprite: {fileID: 21300000, guid: 7674df92c005ec745900b58144c75aa8, type: 3}
    extraImage: {fileID: 0}
  slideInDuration: 0.8
  idleMovementAmount: 10
  idleMovementSpeed: 1
  idleRotationAmount: 2
  extraIdleAmount: 5
  extraIdleSpeed: 1.3
  extraIdleRotation: 1.5
  typingSpeed: 0.05
