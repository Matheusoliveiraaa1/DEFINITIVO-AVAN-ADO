--- !u!114 &1321318705
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1321318701}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 076d04c645b333d4f9fab803d9ed6d2c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialPanel: {fileID: 1321318701}
  professoraImage: {fileID: 1671931763}
  extraImageUI: {fileID: 1780923019}
  tutorialText: {fileID: 1516534292}
  nextButton: {fileID: 197444067}
  slides:
  - message: "Ol\xE1! Eu sou a Maria Sassafras e irei te ensinar como utilizar esse
      aplicativo!  "
    professoraSprite: {fileID: 21300000, guid: 6ccf2619504693f46b5ed7b298afe4b8, type: 3}
    extraImage: {fileID: 0}
    voiceAudio: {fileID: 8300000, guid: 9b63628a8eec5484cb04ee6fb5068478, type: 3}
  - message: "Ao caminhar pela trilha, voc\xEA encontrar\xE1 algumas esp\xE9cies
      que vivem neste parque, como esta ao meu lado."
    professoraSprite: {fileID: 21300000, guid: d37e5e04e1f7f2b4cabe6c369870d588, type: 3}
    extraImage: {fileID: 21300000, guid: d5ceaec2e53b50e4d8e9223562ce42b2, type: 3}
    voiceAudio: {fileID: 8300000, guid: 54e2d84d7f43ccc42a78658dd0cd2965, type: 3}
  - message: "Na cole\xE7\xE3o, voc\xEA pode conhecer melhor as esp\xE9cies encontradas."
    professoraSprite: {fileID: 21300000, guid: 7674df92c005ec745900b58144c75aa8, type: 3}
    extraImage: {fileID: 21300000, guid: 325f19548257d1e48845075246f70556, type: 3}
    voiceAudio: {fileID: 8300000, guid: 23320febb724c5549ab7c026960d23cc, type: 3}
  - message: "Essas esp\xE9cies ser\xE3o utilizadas nas fotografias que voc\xEA far\xE1
      durante o passeio."
    professoraSprite: {fileID: 21300000, guid: d37e5e04e1f7f2b4cabe6c369870d588, type: 3}
    extraImage: {fileID: 21300000, guid: 6f2a6c3aaa39ea641a247a898528cbd7, type: 3}
    voiceAudio: {fileID: 8300000, guid: fd576d0052504c0499da8fe05b2560af, type: 3}
  - message: "Voc\xEA pode consultar o mapa para saber quais \xE1reas j\xE1 visitou
      e aprender mais sobre os ambientes da floresta. "
    professoraSprite: {fileID: 21300000, guid: 6ccf2619504693f46b5ed7b298afe4b8, type: 3}
    extraImage: {fileID: 21300000, guid: ba0ee7812c1ed7142a11126c62e13347, type: 3}
    voiceAudio: {fileID: 8300000, guid: c6f8c367daddb504fb46bfa5e0acad0f, type: 3}
  - message: "No mapa, voc\xEA tamb\xE9m poder\xE1 visualizar as fotos que produziu."
    professoraSprite: {fileID: 21300000, guid: d37e5e04e1f7f2b4cabe6c369870d588, type: 3}
    extraImage: {fileID: 0}
    voiceAudio: {fileID: 8300000, guid: 18c4b93086994d84d826c9b0ead72538, type: 3}
  - message: "Vou deixar algumas esp\xE9cies na sua cole\xE7\xE3o para que voc\xEA
      j\xE1 possa iniciar sua aventura."
    professoraSprite: {fileID: 21300000, guid: 6ccf2619504693f46b5ed7b298afe4b8, type: 3}
    extraImage: {fileID: 0}
    voiceAudio: {fileID: 8300000, guid: 6abdd3fec1e9c2948aa94499b0c8de6a, type: 3}
  - message: "Nos pontos de observa\xE7\xE3o, meu amigo bi\xF3logo ir\xE1 apresentar
      os diferentes ambientes do parque."
    professoraSprite: {fileID: 21300000, guid: 7674df92c005ec745900b58144c75aa8, type: 3}
    extraImage: {fileID: 0}
    voiceAudio: {fileID: 8300000, guid: 5a867882296c2414f8ace74c5c61360c, type: 3}
  - message: "Agora que voc\xEA j\xE1 sabe o b\xE1sico, vamos come\xE7ar!"
    professoraSprite: {fileID: 21300000, guid: d37e5e04e1f7f2b4cabe6c369870d588, type: 3}
    extraImage: {fileID: 0}
    voiceAudio: {fileID: 8300000, guid: 92d6c3faa784f6d49b0247bfa5ad9cc5, type: 3}
  audioSource: {fileID: 1349737915}
  slideInDuration: 0.8
  idleMovementAmount: 10
  idleMovementSpeed: 1
  idleRotationAmount: 2
  extraIdleAmount: 5
  extraIdleSpeed: 1.3
  extraIdleRotation: 1.5
  firstSlideImage: {fileID: 694225395}
  firstSlideEnterDuration: 1
  firstSlideIdleAmount: 6
  firstSlideIdleSpeed: 1.5
  firstSlideIdleRotation: 2
  typingSpeed: 0.05
